@inproceedings{arfeen2024pipefill,
  author = {Arfeen, Daiyaan and Zhang, Zhen and Fu, Xinwei and Ganger, Gregory and Wang, Yida},
  booktitle = {Proceedings of Machine Learning and Systems},
  editor = {M. Zaharia and G. Joshi and Y. Lin},
  pages = {},
