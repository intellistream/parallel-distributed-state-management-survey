@inproceedings{huang2025tigon,
  author = {Huang, Yibo and Chen, Haowei and Ni, Newton and Sun, Yan and Chidambaram, Vijay and Tang, Dixin and Witchel, Emmett},
  title = {Tigon: a distributed database for a CXL pod},
  year = {2025},
  isbn = {978-1-939133-47-2},
  publisher = {USENIX Association},
  address = {USA},
  abstract = {Building efficient distributed transactional databases remains a challenging problem despite decades of research. Existing distributed databases synchronize cross-host concurrent data accesses over a network, which requires numerous message exchanges and introduces performance overhead.We describe Tigon, the first distributed in-memory database that synchronizes concurrent cross-host data accesses using atomic operations on CXL memory. Using CXL memory is more efficient than network-based approaches, but Tigon's design must address CXL's higher latency and lower bandwidth relative to local DRAM, as well as CXL's limited hardware support for cross-host cache coherence. For TPC-C and a variant of YCSB, Tigon achieves up to 2.5\texttimes{} higher throughput compared with two optimized shared-nothing databases that use CXL memory as a transport and up to 18.5\texttimes{} higher throughput compared with an RDMA-based distributed database.},
  booktitle = {Proceedings of the 19th USENIX Conference on Operating Systems Design and Implementation},
  articleno = {7},
  numpages = {20},
  location = {Boston, MA, USA},
  series = {OSDI '25}
}

