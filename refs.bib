  author = {Pan, Rui and Wang, Zhuang and Jia, Zhen and Karakus, Can and Zancato, Luca and Dao, Tri and Wang, Yida and Netravali, Ravi},
  booktitle = {Proceedings of Machine Learning and Systems},
  editor = {M. Zaharia and G. Joshi and Y. Lin},
  pages = {},
  publisher = {MLSys},
  title = {Marconi: Prefix Caching for the Era of Hybrid LLMs},
  url = {https://proceedings.mlsys.org/paper_files/paper/2025/file/7c180af017258d239bac6248d1eb26ac-Paper-Conference.pdf},
